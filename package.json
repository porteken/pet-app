{
  "name": "pet-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && if [ -d public ]; then cp -R public .next/standalone/public; fi",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "node .next/standalone/server.js",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm run test:e2e",
    "test:e2e": "tsx src/testing/run-e2e.ts 'playwright test'",
    "test:e2e:prod": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test --project=chromium'",
    "test:e2e:prod:all": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test'",
    "test:e2e:critical": "tsx src/testing/run-e2e.ts 'playwright test --grep-invert \"responsive design: mobile user journey\"'",
    "test:e2e:critical:prod": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test --project=chromium --grep-invert \"responsive design: mobile user journey\"'",
    "test:e2e:critical:prod:all": "tsx src/testing/run-e2e.ts 'pnpm build && PLAYWRIGHT_SERVER_MODE=production playwright test --grep-invert \"responsive design: mobile user journey\"'",
    "test:unit": "vitest run --exclude='**/*.integration.test.*' --exclude='**/integration.test.*'",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "knip": "knip"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.100.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.2",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.2",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.5",
    "msw": "^2.14.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsc-files": "^1.1.4",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.1.2"
}

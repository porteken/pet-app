{
  "name": "pet-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev  --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test-with-dynamic-port.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug --reporter=line",
    "test:verbose": "playwright test --reporter=line --workers=1",
    "test:single": "playwright test --reporter=line --workers=1 --grep",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=html"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.4",
    "@heroui/react": "^2.7.11",
    "@heroui/theme": "2.4.17",
    "@mui/material": "^7.2.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "eslint-plugin-promise": "^7.2.1",
    "framer-motion": "^12.23.3",
    "ml-regression-simple-linear": "^3.0.1",
    "next": "^15.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-plotly.js": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@next/bundle-analyzer": "^15.3.5",
    "@next/eslint-plugin-next": "^15.4.2",
    "@playwright/test": "^1.48.0",
    "@types/eslint": "^8.56.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.13",
    "@types/plotly.js": "^3.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-plotly.js": "^2.6.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unicorn": "^59.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

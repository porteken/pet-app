{
  "name": "pet-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug --reporter=line",
    "test:verbose": "playwright test --reporter=line --workers=1",
    "test:single": "playwright test --reporter=line --workers=1 --grep",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=html",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next out dist",
    "prepare": "husky install"
  },
  "dependencies": {
    "@nextui-org/react": "^2.4.6",
    "@nextui-org/select": "^2.2.5",
    "@nextui-org/system": "^2.2.5",
    "@nextui-org/theme": "^2.2.9",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/plotly.js": "^2.33.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-plotly.js": "^2.6.3",
    "clsx": "^2.1.0",
    "framer-motion": "^11.3.19",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "ml-regression-simple-linear": "^3.0.1",
    "next": "14.2.4",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.2.1",
    "react-leaflet": "^4.2.1",
    "react-plotly.js": "^2.6.0",
    "react-select": "^5.8.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.4",
    "@playwright/test": "^1.54.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
